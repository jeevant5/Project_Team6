<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html><head><title>Helpdesk | Create account</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body class="centered"><main class="auth"><p class="eyebrow">NORTHSTAR IT OPERATIONS</p><h1>Create account</h1><p class="muted">Set up your helpdesk access.</p><% if (request.getAttribute("error") != null) { %><p class="error"><%= request.getAttribute("error") %></p><% } %><form method="post"><label>Display name<input name="displayName" maxlength="120" required autofocus></label><label>Username<input name="username" minlength="3" maxlength="80" pattern="[A-Za-z0-9._-]+" required></label><label>Password<input type="password" name="password" minlength="8" required></label><label>Confirm password<input type="password" name="confirmPassword" minlength="8" required></label><button>Create account</button></form><p class="auth-link">Already have an account? <a href="${pageContext.request.contextPath}/login">Sign in</a></p></main></body></html>