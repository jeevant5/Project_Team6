<%@ page contentType="text/html;charset=UTF-8" %>
<!doctype html><html><head><title>Helpdesk | Sign in</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head><body class="centered"><main class="auth"><p class="eyebrow">NORTHSTAR IT OPERATIONS</p><h1>Helpdesk</h1><p class="muted">Resolve support work with clarity.</p><% if (request.getParameter("error") != null) { %><p class="error">Invalid credentials.</p><% } %><% if (request.getParameter("registered") != null) { %><p class="success">Account created. You can sign in now.</p><% } %><form method="post"><label>Username<input name="username" required autofocus></label><label>Password<input type="password" name="password" required></label><button>Sign in</button></form><p class="auth-link">Need an account? <a href="${pageContext.request.contextPath}/signup">Create one</a></p></main></body></html>
